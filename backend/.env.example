# development | production
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3001
# IANA zone used for calendar buckets (today / week / month…)
TIME_ZONE=America/Toronto

# Auth: JWT is stored in an httpOnly cookie
JWT_SECRET=change-me-to-a-random-string-of-32-plus-chars
ACCESS_TOKEN_TTL_SECONDS=43200
# optional, defaults to true in production
COOKIE_SECURE=false
# password for all seeded users
SEED_USER_PASSWORD=freitty-demo

# Either DATABASE_URL ...
# DATABASE_URL=postgres://freitty:freitty@localhost:5433/freitty
# ... or discrete settings (DB_HOST may be a unix socket dir, e.g. /var/run/postgresql)
DB_HOST=localhost
DB_PORT=5433
DB_USER=freitty
DB_PASSWORD=freitty
DB_NAME=freitty
DB_SSL=false
