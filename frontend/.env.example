# Dev server: where the /api proxy forwards requests
API_PROXY_TARGET=http://localhost:4000

# Production: absolute API base URL when the API lives on another origin (default: same-origin /api)
# VITE_API_URL=https://api.example.com/api

# development | production (defaults to the Vite mode: dev → development, build → production)
# VITE_APP_ENV=development
